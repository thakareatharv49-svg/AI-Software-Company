COMPANY_ENV=development
COMPANY_HOST=127.0.0.1
COMPANY_PORT=8000
COMPANY_DEBUG=true
COMPANY_MAX_CONCURRENT_RUNS=1
COMPANY_SHUTDOWN_TIMEOUT_SECONDS=30

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT=120

# Optional GitHub delivery. Each factory mission gets its own repository.
GITHUB_TOKEN=
GITHUB_ALLOW_WRITES=false
GITHUB_REPOSITORY_OWNER=
GITHUB_DEFAULT_BRANCH=main
GITHUB_BRANCH_PREFIX=factory

# Owner/customer sign-in (OAuth credentials are optional until sign-in is used).
PUBLIC_BASE_URL=http://127.0.0.1:8000
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
OWNER_EMAIL=
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_software_company
