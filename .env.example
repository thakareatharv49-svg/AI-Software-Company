COMPANY_ENV=development
COMPANY_HOST=127.0.0.1
COMPANY_PORT=8000
COMPANY_DEBUG=true
COMPANY_MAX_CONCURRENT_RUNS=1
COMPANY_SHUTDOWN_TIMEOUT_SECONDS=30

# Optional: skip owner OAuth only for a local, loopback-only development instance.
# Set true in your local .env; keep false for any shared or deployed environment.
LOCAL_ACCESS_ENABLED=false

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT=120

# Host is for local development only; deployed environments must use container.
SANDBOX_MODE=host
SANDBOX_CONTAINER_IMAGE=ai-software-company-sandbox:latest

# Maximum planned/generated files per product (4-200; default 40).
# Increase gradually after validating model quality, RAM, and generation time.
FACTORY_MAX_GENERATED_PROJECT_FILES=40

# Maximum independent tasks executed concurrently (1-8; default 2).
# Keep low on machines running Ollama locally; raise only after measuring RAM/latency.
FACTORY_MAX_PARALLEL_TASKS=2

# Maximum attempts per task, including the first attempt (1-5; default 2).
FACTORY_TASK_MAX_ATTEMPTS=2

# Optional GitHub delivery. Each factory mission gets its own repository.
GITHUB_TOKEN=
GITHUB_ALLOW_WRITES=false
GITHUB_REPOSITORY_OWNER=
GITHUB_DEFAULT_BRANCH=main
GITHUB_BRANCH_PREFIX=factory

# Optional sign-in for shared/deployed environments.
PUBLIC_BASE_URL=http://127.0.0.1:8000
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
OWNER_EMAIL=
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_software_company

# Optional: dedicated read-only aggregate status endpoint for Nexora HQ (minimum 32 characters).
NEXORA_HQ_STATUS_TOKEN=
